<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.olh.background-rebalance</string>

  <!-- Runs dev/run-background-rebalance.sh, which reads the Airtable PAT
       from Keychain and defaults to a DRY RUN (no writes) unless --apply
       is passed here. Left as a dry run until reviewed against a few
       live intervals. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/mauricio.delgado/olh-tracker-web/dev/run-background-rebalance.sh</string>
  </array>

  <!-- Every 2 minutes. Tightened down from an initial 15-min interval on
       2026-08-17 so a walk selected on Walks To Schedule gets picked up
       by the next tick almost immediately, without needing genuine
       event-driven infrastructure (Azure Static Web Apps' Free-tier
       managed functions have no Queue/Durable Functions support here --
       see api/host.json -- so a real fire-on-selection trigger from
       update-job.js would need a separate linked Functions app; this
       interval is the no-new-infrastructure approximation of that). The
       script's own withinRunWindow() check (weekday, 7am-7pm) decides
       whether a given firing actually hits Airtable, so this stays a
       flat interval rather than an enumerated calendar rule. Each idle
       tick outside that window costs nothing; each tick inside it costs
       one Airtable read pass even when there's nothing to change. -->
  <key>StartInterval</key>
  <integer>120</integer>

  <!-- Do not run on load -- loading this should not itself trigger a run. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/mauricio.delgado/.homesite_coe_report/launchd.background-rebalance.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mauricio.delgado/.homesite_coe_report/launchd.background-rebalance.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
