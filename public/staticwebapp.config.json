{
  "platform": {
    "apiRuntime": "node:22"
  },
  "routes": [
    { "route": "/netlify/*", "statusCode": 404 },
    { "route": "/dev/*", "statusCode": 404 },
    { "route": "/README.md", "statusCode": 404 },
    { "route": "/AZURE-DEPLOY.md", "statusCode": 404 },
    { "route": "/.gitignore", "statusCode": 404 },
    { "route": "/.DS_Store", "statusCode": 404 },
    { "route": "/staticwebapp.config.json", "statusCode": 404 },
    { "route": "/*.zip", "statusCode": 404 },
    { "route": "/*.tar.gz", "statusCode": 404 },
    { "route": "/*.xlsx", "statusCode": 404 },

    { "route": "/tracker-new", "redirect": "/tracker", "statusCode": 301 },
    { "route": "/tracker-new.html", "redirect": "/tracker", "statusCode": 301 },

    { "route": "/tracker", "rewrite": "/tracker.html", "headers": { "Cache-Control": "no-store, must-revalidate" } },
    { "route": "/completion", "rewrite": "/completion.html", "headers": { "Cache-Control": "no-store, must-revalidate" } },
    { "route": "/scheduler", "rewrite": "/scheduler.html", "headers": { "Cache-Control": "no-store, must-revalidate" } },
    { "route": "/walk-calendar", "rewrite": "/walk-calendar.html", "headers": { "Cache-Control": "no-store, must-revalidate" } },
    { "route": "/workload", "rewrite": "/workload.html", "headers": { "Cache-Control": "no-store, must-revalidate" } },
    { "route": "/workload-visualizer", "rewrite": "/workload-visualizer.html", "headers": { "Cache-Control": "no-store, must-revalidate" } },
    { "route": "/admin", "rewrite": "/admin.html", "headers": { "Cache-Control": "no-store, must-revalidate" } },

    { "route": "/*.html", "headers": { "Cache-Control": "no-store, must-revalidate" } },

    { "route": "/api/*", "headers": { "Cache-Control": "no-store", "X-Robots-Tag": "noindex, nofollow" } },

    { "route": "/fonts/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "route": "/vendor/*", "headers": { "Cache-Control": "public, max-age=604800" } }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "globalHeaders": {
    "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet, noimageindex",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=()"
  }
}
